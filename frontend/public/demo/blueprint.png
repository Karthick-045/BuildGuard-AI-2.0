<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 650" width="1000" height="650">
  <defs>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#1e293b" stroke-width="1"/>
    </pattern>
  </defs>
  <rect width="1000" height="650" fill="#0f172a"/>
  <rect width="1000" height="650" fill="url(#grid)"/>

  <!-- Outer Walls -->
  <rect x="30" y="30" width="940" height="580" fill="none" stroke="#38bdf8" stroke-width="4" stroke-dasharray="12,4"/>

  <!-- Left Rooms (A, B, C) -->
  <rect x="40" y="40" width="180" height="140" fill="#1e293b" stroke="#0ea5e9" stroke-width="2" rx="4"/>
  <text x="130" y="115" fill="#f8fafc" font-family="sans-serif" font-size="16" font-weight="bold" text-anchor="middle">ROOM A</text>

  <rect x="40" y="200" width="180" height="140" fill="#1e293b" stroke="#0ea5e9" stroke-width="2" rx="4"/>
  <text x="130" y="275" fill="#f8fafc" font-family="sans-serif" font-size="16" font-weight="bold" text-anchor="middle">ROOM B</text>

  <rect x="40" y="360" width="180" height="140" fill="#1e293b" stroke="#0ea5e9" stroke-width="2" rx="4"/>
  <text x="130" y="435" fill="#f8fafc" font-family="sans-serif" font-size="16" font-weight="bold" text-anchor="middle">ROOM C</text>

  <!-- Central Corridor C -->
  <rect x="240" y="80" width="80" height="340" fill="#0284c7" fill-opacity="0.15" stroke="#38bdf8" stroke-width="2" stroke-dasharray="6,4"/>
  <text x="280" y="250" fill="#38bdf8" font-family="sans-serif" font-size="14" font-weight="bold" text-anchor="middle" transform="rotate(-90 280 250)">CORRIDOR C (PRIMARY)</text>

  <!-- Stair 1 -->
  <rect x="200" y="440" width="80" height="70" fill="#f59e0b" fill-opacity="0.2" stroke="#f59e0b" stroke-width="2"/>
  <line x1="200" y1="455" x2="280" y2="455" stroke="#f59e0b" stroke-width="2"/>
  <line x1="200" y1="475" x2="280" y2="475" stroke="#f59e0b" stroke-width="2"/>
  <line x1="200" y1="495" x2="280" y2="495" stroke="#f59e0b" stroke-width="2"/>
  <text x="240" y="480" fill="#f59e0b" font-family="sans-serif" font-size="12" font-weight="bold" text-anchor="middle">STAIR 1</text>

  <!-- Exit B -->
  <rect x="50" y="520" width="150" height="60" fill="#dc2626" fill-opacity="0.2" stroke="#ef4444" stroke-width="3" rx="4"/>
  <text x="125" y="555" fill="#ef4444" font-family="sans-serif" font-size="16" font-weight="bold" text-anchor="middle">EMERGENCY EXIT B</text>

  <!-- Right Rooms (D, E, F) -->
  <rect x="620" y="40" width="180" height="140" fill="#1e293b" stroke="#0ea5e9" stroke-width="2" rx="4"/>
  <text x="710" y="115" fill="#f8fafc" font-family="sans-serif" font-size="16" font-weight="bold" text-anchor="middle">ROOM D</text>

  <rect x="620" y="200" width="180" height="140" fill="#1e293b" stroke="#0ea5e9" stroke-width="2" rx="4"/>
  <text x="710" y="275" fill="#f8fafc" font-family="sans-serif" font-size="16" font-weight="bold" text-anchor="middle">ROOM E</text>

  <rect x="620" y="360" width="180" height="140" fill="#1e293b" stroke="#0ea5e9" stroke-width="2" rx="4"/>
  <text x="710" y="435" fill="#f8fafc" font-family="sans-serif" font-size="16" font-weight="bold" text-anchor="middle">ROOM F</text>

  <!-- Corridor West -->
  <rect x="520" y="80" width="80" height="340" fill="#0284c7" fill-opacity="0.15" stroke="#38bdf8" stroke-width="2" stroke-dasharray="6,4"/>
  <text x="560" y="250" fill="#38bdf8" font-family="sans-serif" font-size="14" font-weight="bold" text-anchor="middle" transform="rotate(90 560 250)">CORRIDOR WEST</text>

  <!-- Exit A -->
  <rect x="830" y="220" width="120" height="80" fill="#16a34a" fill-opacity="0.2" stroke="#22c55e" stroke-width="3" rx="4"/>
  <text x="890" y="265" fill="#22c55e" font-family="sans-serif" font-size="16" font-weight="bold" text-anchor="middle">MAIN EXIT A</text>

  <!-- South Rooms (G, H) -->
  <rect x="340" y="460" width="130" height="110" fill="#1e293b" stroke="#0ea5e9" stroke-width="2" rx="4"/>
  <text x="405" y="520" fill="#f8fafc" font-family="sans-serif" font-size="14" font-weight="bold" text-anchor="middle">ROOM G</text>

  <rect x="490" y="460" width="130" height="110" fill="#1e293b" stroke="#0ea5e9" stroke-width="2" rx="4"/>
  <text x="555" y="520" fill="#f8fafc" font-family="sans-serif" font-size="14" font-weight="bold" text-anchor="middle">ROOM H</text>

  <!-- Ramp 1 -->
  <rect x="340" y="380" width="160" height="50" fill="#8b5cf6" fill-opacity="0.2" stroke="#a78bfa" stroke-width="2" stroke-dasharray="4,4"/>
  <text x="420" y="410" fill="#a78bfa" font-family="sans-serif" font-size="13" font-weight="bold" text-anchor="middle">RAMP 1 (ADA)</text>
</svg>
